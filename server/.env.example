# ==============================================================================
# GENFREX Unified Business Management Platform - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Primary MongoDB Atlas Connection
# Replace with your MongoDB Atlas connection string (or local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/clientportal

# JWT Security
JWT_SECRET=clientflow_jwt_secret_super_secure_key_2026_hackathon

# Official GENFREX Email & SMTP Configuration
OFFICIAL_EMAIL=genfrexofficial@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=genfrexofficial@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_SECURE=false
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=GENFREX People Operations <hr@genfrex.com>

# ==============================================================================
# PRIMARY CLOUD STORAGE: GOOGLE DRIVE API (Enterprise Cloud File Storage)
# ==============================================================================
# All GENFREX files (Client deliverables, HR documents, Employee files, appointment PDFs)
# are stored securely in Google Drive through the authenticated backend.
# Public Drive links are strictly prevented; files are streamed via secure backend proxy.

# Google Drive OAuth 2.0 Credentials (Recommended for dedicated GENFREX storage account)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# Google Drive Root Folder ID (The ID of the parent 'GENFREX' folder in Google Drive)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id

# Alternative: Google Service Account Credentials (if using Service Account instead of OAuth)
# Share your GENFREX root Drive folder with this service account email with 'Editor' permissions.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
# Optional path to service account key file:
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json

# File Upload Limits
MAX_FILE_SIZE_MB=25

# ==============================================================================
# CLOUD STORAGE TIER: CLOUDINARY (Optional Public Media CDN)
# ==============================================================================
# Used optionally for avatars and public media assets.
# If omitted, system seamlessly routes to Google Drive / secure local storage.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# CLOUD STORAGE TIER: PRIVATE S3-COMPATIBLE STORAGE (Optional Secondary Fallback)
# ==============================================================================
# Compatible with AWS S3, Cloudflare R2, MinIO, Wasabi.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=genfrex-confidential-documents
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
